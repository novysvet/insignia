+// One captured graph for the whole 5-layer block forward: 144 kernel nodes +
+// 1 D2D memcpy node (see the header). Any failure permanently disables the
+// graph for this drafter and the caller re-runs forward() uncaptured, which
+// issues the identical kernel sequence - the fallback is bit-exact.
+bool DFlash2Drafter::forward_graphed(int anchor, int anchor_position, cudaStream_t stream) {
+    static const bool enabled = [] {
+        const char *value = std::getenv("INSIGNIA_GLM53_GRAPHS");
+        return !value || std::atoi(value) != 0;
+    }();
+    if (!pos_pinned_) {
+        if (cudaHostAlloc(&pos_pinned_, sizeof(int), cudaHostAllocDefault) != cudaSuccess ||
+            cudaMalloc(&pos_dev_, sizeof(int)) != cudaSuccess) {
+            pos_pinned_ = nullptr;   // alloc pair is all-or-nothing
+            graphs_broken_ = true;
+            return false;
+        }
+    }
+    // Refresh FIRST so every early-out below still leaves a correct pinned
+    // value for an uncaptured forward() (pos_dev_ keeps the old argument
+    // semantics via the captured memcpy node inside forward()).
+    *pos_pinned_ = anchor_position;
+    // Trace/dump modes interleave synchronous downloads inside forward(); a
+    // capture would invalidate. Those sessions keep the uncaptured path.
+    if (!enabled || graphs_broken_ || df_dump_file() ||
+        std::getenv("INSIGNIA_GLM53_DF_LTRACE") || std::getenv("INSIGNIA_GLM53_DF_ITRACE"))
+        return false;
+    if (forward_exec_) {
+        if (cudaGraphLaunch(forward_exec_, stream) != cudaSuccess) {
+            graphs_broken_ = true;
+            return false;
+        }
+        return true;
+    }
+    // One warm-up pass resolves the static env probes inside forward() before
+    // anything is recorded (all drafter allocations are constructor-time, so a
+    // single pass suffices).
+    if (forward_uses_++ == 0) {
+        forward(anchor, anchor_position, stream);
+        return true;
+    }
+    if (cudaStreamBeginCapture(stream, cudaStreamCaptureModeThreadLocal) != cudaSuccess) {
+        graphs_broken_ = true;
+        return false;
+    }
+    bool threw = false;
+    try {
+        forward(anchor, anchor_position, stream);
+    } catch (...) {
+        threw = true;
+    }
+    cudaGraph_t graph = nullptr;
+    const cudaError_t ended = cudaStreamEndCapture(stream, &graph);
+    if (threw || ended != cudaSuccess || !graph) {
+        if (graph) cudaGraphDestroy(graph);
+        graphs_broken_ = true;
+        return false;  // capture invalidated: nothing executed, caller re-runs
+    }
+    if (cudaGraphInstantiateWithFlags(&forward_exec_, graph, 0) != cudaSuccess) {
+        cudaGraphDestroy(graph);
+        forward_exec_ = nullptr;
+        graphs_broken_ = true;
+        return false;
+    }
+    cudaGraphDestroy(graph);
+    if (cudaGraphLaunch(forward_exec_, stream) != cudaSuccess) {
+        graphs_broken_ = true;
+        return false;
+    }

From: CUDA-Graph capture sketch for the GLM-5.3 DFlash2 decode/verify path
Subject: [GRAPH-SKETCH] stream-capture the static spans of a verify round

Sketch status (NOT compilable as-is; mechanical TODOs are marked GRAPH-TODO):
  - Precedent in tree: src/decode.cu (Qwen insig4 path) already does
    cudaStreamBeginCapture(ThreadLocal) + cudaGraphLaunch with a pinned
    next-token staging memcpy, and src/cuda13_probe.cu probed pinned-memcpy
    capture + cudaGraphExecKernelNodeSetParams on this exact WSL2/CUDA-13.3
    driver stack. This sketch reuses those patterns.
  - Phase 1: drafter forward + df lm_head + df_commit graphs (zero parity
    surface beyond int-scalar externalization).
  - Phase 2: per-(k, phase) verify/scalar fragment graphs for the static
    spans between router resolutions; expert staging stays eager.
  - Phase 3 (optional, largest): per-8-batch expert mini-graphs over 8
    dedicated fixed VRAM slots. Only outlined here.

Determinism note: graph replay preserves kernel order and arguments
bit-for-bit. The ONLY semantics-touching edits are (a) kernels that took
position/ctx_len/combine-weight scalars by value now read them from a
pinned parameter page (identical integer/float values -> identical FP
behavior), and (b) scale_add reads its weight from pinned memory instead
of a kernel argument. Both must pass the full parity gate (greedy IDs +
digit-identical top-10 logits + 30/40/100/240-token sequence checks)
against INSIGNIA_GLM53_GRAPHS=0 before landing.

diff --git a/include/insignia_glm53_graph.cuh b/include/insignia_glm53_graph.cuh
new file mode 100644
--- /dev/null
+++ b/include/insignia_glm53_graph.cuh
@@ -0,0 +1,64 @@
+#pragma once
+// GRAPH-SKETCH: parameter page + fragment-graph bank for decode/verify.
+// One pinned page is written by the host before each graph launch and read
+// by kernels through UVA (zero API calls per parameter update; WSL2 + UVA
+// verified by src/cuda13_probe.cu patterns; fallback = one cudaMemcpyAsync
+// into a device mirror before cudaGraphLaunch, as decode.cu does).
+namespace insignia::glm53 {
+
+struct GraphParamPage {
+    int   position_base;              // verify/prefill anchor position
+    int   ctx_len;                    // drafter attention length
+    int   df_anchor_position;         // drafter RoPE position
+    int   commit_pos0;                // df kv_append base
+    int   k;                          // active verify rows (grids stay kMaxVerify)
+    float combine[8 /*kMaxVerify*/ * 8 /*topk*/];  // scale_add weights, per (token, pick)
+    int   row_ids[8];                 // phase-3 expert batch user rows
+    float expert_globals[8][3];       // phase-3 per-slot record global scales
+};
+
+// Owns one instantiated exec per capture key. Lazy: a shape that has not run
+// eagerly at least once is never captured (weights must already be resident:
+// Q8 pin_all, BF16 stager resident map, f32_cache_), because TensorStager::
+// stage_new issues a synchronous cudaMemcpy that is illegal during capture.
+class FragmentGraphBank {
+public:
+    void launch(uint64_t key, cudaStream_t stream) {
+        const auto found = execs_.find(key);
+        if (found != execs_.end()) {
+            check(cudaGraphLaunch(found->second, stream), "fragment graph launch");
+            return;
+        }
+        require(pending_ != cudaGraph_t{}, "fragment capture not armed");
+        check(cudaStreamEndCapture(stream, &pending_), "fragment end capture");
+        cudaGraphExec_t exec = nullptr;
+        check(cudaGraphInstantiate(&exec, pending_, nullptr, nullptr, 0),
+              "fragment instantiate");
+        check(cudaGraphDestroy(pending_), "fragment destroy template");
+        pending_ = cudaGraph_t{};
+        execs_.emplace(key, exec);
+    }
+    void arm(cudaStream_t stream) {  // begin capture for the next key
+        check(cudaStreamBeginCapture(stream, cudaStreamCaptureModeThreaded),
+              "fragment begin capture");
+    }
+    bool armed() const { return pending_ != cudaGraph_t{}; }
+    ~FragmentGraphBank() {
+        for (auto &[key, exec] : execs_) if (exec) cudaGraphExecDestroy(exec);
+    }
+private:
+    std::unordered_map<uint64_t, cudaGraphExec_t> execs_;
+    cudaGraph_t pending_ = cudaGraph_t{};
+};
+
+}  // namespace insignia::glm53

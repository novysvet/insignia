+// ---------------------------------------------------------------------------
+// CUDA graph scaffolding (INSIGNIA_GLM53_GRAPHS=0 disables everywhere).
+//
+// Protocol per region: one uncaptured warm-up pass (resolves lazy residency:
+// Q8/BF16 stager resident maps, f32_cache_, static env probes), then one
+// capture pass (cudaStreamCaptureModeThreadLocal - the ExpertStager reader
+// pool and copy_stream_ keep issuing async copies from other threads, which
+// ThreadLocal mode tolerates), then perpetual cudaGraphLaunch. Any failure
+// marks the region broken and the caller re-runs the region uncaptured, so
+// the executed kernel sequence is exactly what today's code issues.
+//
+// Constraints honored by every region body:
+//  - only stream-ordered work on the passed stream (kernel launches,
+//    cudaMemcpyAsync with fixed pinned/device addresses, cudaMemsetAsync);
+//    a synchronous cudaMemcpy or a default-stream op would invalidate capture;
+//  - no cudaMalloc inside a region (warm-up allocates any lazy residency);
+//  - all addresses baked into the graph are process-lifetime allocations
+//    (resident FP8 cache, drafter buffers, Runner scratch) - the resident
+//    maps are append-only, so baked pointers never dangle.
+// ---------------------------------------------------------------------------
+class GraphRegion {
+public:
+    GraphRegion() = default;
+    ~GraphRegion() {
+        if (exec_) cudaGraphExecDestroy(exec_);
+    }
+    GraphRegion(const GraphRegion &) = delete;
+    GraphRegion &operator=(const GraphRegion &) = delete;
+
+    // Launch `body` as a replayed graph. Returns true when the work has been
+    // launched (graph replay, the capture-round cudaGraphLaunch, or a
+    // warm-up pass); false means graphs are unusable and the caller must run
+    // the region itself on the legacy default stream.
+    template <typename Body>
+    bool run(cudaStream_t stream, Body &&body) {
+        if (broken_ || !graphs_supported()) return false;
+        if (exec_) {
+            if (cudaGraphLaunch(exec_, stream) != cudaSuccess) {
+                broken_ = true;
+                return false;
+            }
+            return true;
+        }
+        if (uses_++ < kWarmups) {
+            body(stream);
+            return true;
+        }
+        if (cudaStreamBeginCapture(stream, cudaStreamCaptureModeThreadLocal) != cudaSuccess) {
+            broken_ = true;
+            return false;
+        }
+        bool threw = false;
+        try {
+            body(stream);
+        } catch (...) {
+            threw = true;
+        }
+        cudaGraph_t graph = nullptr;
+        const cudaError_t ended = cudaStreamEndCapture(stream, &graph);
+        if (threw || ended != cudaSuccess || !graph) {
+            if (graph) cudaGraphDestroy(graph);
+            broken_ = true;
+            return false;  // capture invalidated: nothing executed, re-run
+        }
+        if (cudaGraphInstantiateWithFlags(&exec_, graph, 0) != cudaSuccess) {
+            cudaGraphDestroy(graph);
+            exec_ = nullptr;
+            broken_ = true;
+            return false;
+        }
+        cudaGraphDestroy(graph);
+        if (cudaGraphLaunch(exec_, stream) != cudaSuccess) {
+            broken_ = true;
+            return false;
+        }
+        return true;
+    }
+
+private:
+    static constexpr int kWarmups = 1;
+    static bool graphs_supported() {
+        static const bool supported = [] {
+            const char *value = std::getenv("INSIGNIA_GLM53_GRAPHS");
+            if (value && !std::atoi(value)) return false;
+            // The linear-debug hook downloads synchronously per GEMV; keep
+            // those sessions fully uncaptured.
+            if (std::getenv("INSIGNIA_GLM53_CHECK_LINEAR")) return false;
+            // Minimal WSL2/driver smoke test: capture -> instantiate ->
+            // launch -> sync. WSL graph support is verified, not assumed.
+            cudaStream_t stream = nullptr;
+            int *pinned = nullptr, *device = nullptr;

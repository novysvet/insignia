+cudaError_t kda_fused_chunk(
+    float *state,
+    const float *q_raw, const float *k_raw, const float *v_raw,
+    const float *gate_f, const float *gate_g, const float *beta,
+    const void *conv_q, const void *conv_k, const void *conv_v,
+    const float *dt_bias, const float *a_log, const uint16_t *norm_weight,
+    float *conv_history, float *output,
+    int tokens, int position_base,
+    int heads, int head_dim, bool weights_fp32, cudaStream_t stream) {
+    if (head_dim != 128 || tokens < 1) return cudaErrorInvalidValue;
+    const size_t smem = size_t(head_dim) * head_dim * sizeof(float) + 128;  // 64 KiB + align pad
+    // One-time dynamic-smem opt-in (default cap is 48 KiB; sm_89 allows 99 KiB).
+    static const bool opted = [] {
+        bool ok = cudaFuncSetAttribute(kda_fused_chunk_kernel<128, true>,
+                                       cudaFuncAttributeMaxDynamicSharedMemorySize,
+                                       128 * 128 * (int)sizeof(float) + 128) == cudaSuccess;
+        ok = cudaFuncSetAttribute(kda_fused_chunk_kernel<128, false>,
+                                  cudaFuncAttributeMaxDynamicSharedMemorySize,
+                                  128 * 128 * (int)sizeof(float) + 128) == cudaSuccess && ok;
+        return ok;
+    }();
+    if (!opted) return cudaErrorInvalidValue;
+    const int width = heads * head_dim;
+    if (weights_fp32)
+        kda_fused_chunk_kernel<128, true><<<heads, 128, smem, stream>>>(
+            state, q_raw, k_raw, v_raw, gate_f, gate_g, beta, conv_q, conv_k, conv_v,
+            dt_bias, a_log, norm_weight, conv_history, output, tokens, position_base, width);
+    else
+        kda_fused_chunk_kernel<128, false><<<heads, 128, smem, stream>>>(
+            state, q_raw, k_raw, v_raw, gate_f, gate_g, beta, conv_q, conv_k, conv_v,
+            dt_bias, a_log, norm_weight, conv_history, output, tokens, position_base, width);
+    return cudaGetLastError();
+}

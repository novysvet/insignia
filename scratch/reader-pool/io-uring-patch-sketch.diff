+                              state.layer, state.expert,
+                              uring_scratch_[state.uring_slot],
+                              packed_entry(state.layer, state.expert).stored_bytes);
+            } catch (...) { state.error = std::current_exception(); }
+            {
+                std::lock_guard<std::mutex> lock(pool_mutex_);
+                state.done = true;
+                state.end = std::chrono::steady_clock::now();
+            }
+            pool_done_.notify_all();
+        }
+    }

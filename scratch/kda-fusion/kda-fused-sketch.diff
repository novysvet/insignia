@@ -458,6 +458,160 @@ constexpr int kMlaExactContext = 256;
 // (after kda_conv_silu3_kernel; kept adjacent so the transplant stays reviewable)
+// ---------------------------------------------------------------------------
+// Fused chunk recurrence. One block per head (gridDim.x = heads), blockDim.x
+// = HEAD_DIM: the element-parallel geometry of kda_decode_kernel is forced by
+// the determinism law (the key loops accumulate serially in ascending key
+// order; parallelizing keys would need a reduction tree = reassociation =
+// rejected). Dynamic smem carries this head's 128x128 FP32 state (64 KiB);
+// the static arrays sq/sk/decay/delta/norms/partial keep the transplanted
+// cross-thread reduction shapes; hist is the 3x3 ring of raw conv samples.
+// P11(a): smem/global round-trips of f32 are bit-preserving transports.
+// P11(b): every FP statement below is a verbatim transplant, so nvcc's
+// contraction decisions see the same expression DAG as the standalone
+// kernels; explicit fmaf() calls pin the contraction-sensitive trees.
+// P11(c): the conv keeps the exact slot indexing (position - lag) % 3 with
+// the current-first fmaf chain of kda_conv_silu3_kernel.
+// ---------------------------------------------------------------------------
+template <int HEAD_DIM, bool WEIGHTS_FP32>
+__global__ __launch_bounds__(HEAD_DIM, 1) void kda_fused_chunk_kernel(
+    float *__restrict__ state,
+    const float *__restrict__ q_raw, const float *__restrict__ k_raw,
+    const float *__restrict__ v_raw,
+    const float *__restrict__ gate_f_raw, const float *__restrict__ gate_g_raw,
+    const float *__restrict__ beta_raw,
+    const void *__restrict__ conv_q, const void *__restrict__ conv_k,
+    const void *__restrict__ conv_v,
+    const float *__restrict__ dt_bias, const float *__restrict__ a_log,
+    const uint16_t *__restrict__ norm_weight,
+    float *__restrict__ conv_history,
+    float *__restrict__ output,
+    int tokens, int position_base, int width) {
+    static_assert(HEAD_DIM == 128, "fused KDA chunk is compiled for the GLM 64x128 geometry");
+    constexpr int WARPS = HEAD_DIM / 32;
+    const int head = blockIdx.x;
+    const int element = threadIdx.x;
+    const int offset = head * HEAD_DIM;
+    const int lane = element & 31;
+    const int warp = element >> 5;
+
+    // Cross-thread scratch (transplanted shapes, 128B-aligned per AGENTS).
+    __shared__ __align__(128) float norms[2][WARPS];
+    __shared__ __align__(128) float sq[HEAD_DIM], sk[HEAD_DIM], decay[HEAD_DIM], delta[HEAD_DIM];
+    __shared__ __align__(128) float partial[8];
+    __shared__ __align__(128) float hist[3][3][HEAD_DIM]; // [segment][ring slot][element]
+
+    // The 64 KiB FP32 recurrent state in dynamic smem, manually 128B-aligned.
+    extern __shared__ unsigned char smem_raw[];
+    float *head_state = reinterpret_cast<float *>(
+        (reinterpret_cast<uintptr_t>(smem_raw) + 127) & ~uintptr_t(127));
+
+    // Per-thread invariant loads (hoisted loads are bit-preserving, P11(a)).
+    const uint16_t *conv16[3] = {static_cast<const uint16_t *>(conv_q),
+                                 static_cast<const uint16_t *>(conv_k),
+                                 static_cast<const uint16_t *>(conv_v)};
+    const float *conv32[3] = {static_cast<const float *>(conv_q),
+                              static_cast<const float *>(conv_k),
+                              static_cast<const float *>(conv_v)};
+    float taps[3][4];
+#pragma unroll
+    for (int seg = 0; seg < 3; ++seg)
+#pragma unroll
+        for (int tap = 0; tap < 4; ++tap)
+            taps[seg][tap] = WEIGHTS_FP32 ? conv32[seg][size_t(offset + element) * 4 + tap]
+                                          : bf16_to_float(conv16[seg][size_t(offset + element) * 4 + tap]);
+    const float dt_bias_v = dt_bias[offset + element];
+    const float a_log_v = a_log[head];
+    const float norm_v = bf16_value(norm_weight[element]);   // bf16_value == bf16_to_float tree
+
+    // Seed state and conv ring from global (identical bits the per-token
+    // kernels would read; conv_history_ is zero-initialized at context start).
+#pragma unroll
+    for (int key = 0; key < HEAD_DIM; ++key)
+        head_state[key * HEAD_DIM + element] =
+            state[size_t(head) * HEAD_DIM * HEAD_DIM + key * HEAD_DIM + element];
+#pragma unroll
+    for (int seg = 0; seg < 3; ++seg)
+#pragma unroll
+        for (int slot = 0; slot < 3; ++slot)
+            hist[seg][slot][element] =
+                conv_history[size_t(seg) * 3 * width + size_t(slot) * width + offset + element];
+
+    for (int t = 0; t < tokens; ++t) {
+        const int position = position_base + t;
+        const size_t row = size_t(t) * width;
+        float current[3] = {q_raw[row + offset + element],
+                            k_raw[row + offset + element],
+                            v_raw[row + offset + element]};
+
+        // ---- conv + SiLU, VERBATIM from kda_conv_silu3_kernel per segment:
+        // projection[within] -> current[seg] register, segment_history ->
+        // hist[seg], within -> offset+element. Current-first tap order and
+        // the (position - lag) % 3 slot selection are unchanged (P11(c)).
+#pragma unroll
+        for (int seg = 0; seg < 3; ++seg) {
+            float value = current[seg] * taps[seg][3];
+#pragma unroll
+            for (int lag = 1; lag <= 3; ++lag) {
+                if (position >= lag) {
+                    const int slot = (position - lag) % 3;
+                    value = fmaf(hist[seg][slot][element], taps[seg][3 - lag], value);
+                }
+            }
+            hist[seg][position % 3][element] = current[seg];
+            current[seg] = value / (1.0f + expf(-value));
+        }
+
+        // ---- f-gate, VERBATIM from kda_gate_kernel lines 349-354:
+        // forget[index] -> local forget (the global round-trip was bit-
+        // preserving); beta[head] -> local beta_v (same input bits in).
+        const float g_raw = gate_f_raw[row + offset + element];
+        const float argument = __expf(a_log_v) * (g_raw + dt_bias_v);
+        const float forget = -5.0f / (1.0f + __expf(-argument));
+        const float beta_v = 1.0f / (1.0f + __expf(-beta_raw[size_t(t) * gridDim.x + head]));
+
+        // ---- recurrence, VERBATIM from kda_decode_kernel lines 332-381:
+        // q_input/k_input/v -> current[0]/current[1]/current[2] registers,
+        // g -> forget register, beta[head] -> beta_v, state -> head_state
+        // (smem), output -> feeds the output stage in-register.
+        float q = current[0];
+        float k = current[1];
+        float qn = q * q;
+        float kn = k * k;
+        qn = warp_sum(qn);
+        kn = warp_sum(kn);
+        if (!lane) {
+            norms[0][warp] = qn;
+            norms[1][warp] = kn;
+        }
+        __syncthreads();
+        if (!element) {
+            float qsum = 0.0f, ksum = 0.0f;
+#pragma unroll
+            for (int index = 0; index < WARPS; ++index) {
+                qsum += norms[0][index];
+                ksum += norms[1][index];
+            }
+            norms[0][0] = rsqrtf(qsum + 1.0e-6f) * rsqrtf((float)HEAD_DIM);
+            norms[0][1] = rsqrtf(ksum + 1.0e-6f);
+        }
+        __syncthreads();
+        const float q_scale = norms[0][0], k_scale = norms[0][1];
+        sq[element] = q * q_scale;
+        sk[element] = k * k_scale;
+        decay[element] = expf(forget);           // VERBATIM: expf(g[...]), NOT __expf
+        __syncthreads();
+
+        float memory = 0.0f;
+#pragma unroll
+        for (int key = 0; key < HEAD_DIM; ++key) {
+            const float cell = head_state[key * HEAD_DIM + element];
+            memory = fmaf(cell * decay[key], sk[key], memory);
+        }
+        delta[element] = (current[2] - memory) * beta_v;
+        __syncthreads();
+
+        float result = 0.0f;
+#pragma unroll
+        for (int key = 0; key < HEAD_DIM; ++key) {
+            float &cell = head_state[key * HEAD_DIM + element];
+            cell = fmaf(sk[key], delta[element], cell * decay[key]);
+            result = fmaf(cell, sq[key], result);
+        }
+
+        // ---- output stage, VERBATIM from kda_output_kernel lines 366-383:
+        // core[offset+element] -> result register, gate -> gate_g_raw row,
+        // norm_weight[element] -> norm_v register; head_dim == HEAD_DIM.
+        const float value = result;
+        float square = warp_sum(value * value);
+        if (!lane) partial[warp] = square;
+        __syncthreads();
+        if (!warp) {
+            square = lane < WARPS ? partial[lane] : 0.0f;
+            square = warp_sum(square);
+            if (!lane) partial[0] = rsqrtf(square * (1.0f / float(HEAD_DIM)) + 1.0e-5f);
+        }
+        __syncthreads();
+        const float gate_value = gate_g_raw[row + offset + element];
+        output[row + offset + element] = value * partial[0] * norm_v /
+                                         (1.0f + __expf(-gate_value));
+    }
+
+    // Write the carried state and ring back with the values the per-token
+    // kernels would have left in exactly those slots.
+#pragma unroll
+    for (int key = 0; key < HEAD_DIM; ++key)
+        state[size_t(head) * HEAD_DIM * HEAD_DIM + key * HEAD_DIM + element] =
+            head_state[key * HEAD_DIM + element];
+#pragma unroll
+    for (int seg = 0; seg < 3; ++seg)
+#pragma unroll
+        for (int slot = 0; slot < 3; ++slot)
+            conv_history[size_t(seg) * 3 * width + size_t(slot) * width + offset + element] =
+                hist[seg][slot][element];
+}
+

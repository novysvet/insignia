+// Fused KDA chunk recurrence: conv(q/k/v)+SiLU, f-gate, T-step DeltaNet
+// recurrence with the FP32 state resident in 64 KiB dynamic shared memory,
+// and the o_norm+gated output stage, all in ONE launch per layer per chunk.
+// Bit-exact replacement for the per-token kernel sequence (P11): every
+// expression tree is transplanted verbatim; only the state cell storage
+// (global -> smem) and the inter-kernel global round-trips (removed) change.
+// gate_f is the RAW f_b output (pre-gate-transform), gate_g the RAW g_b
+// output; both GEMMs must have run before this launch. q_raw/k_raw/v_raw are
+// PRE-conv projections (the archive semantics of kda_multi are preserved:
+// the kernel never writes them). conv_history is [9, width] for this layer
+// ({q,k,v} x 3 ring slots of raw pre-conv values), state is
+// [heads, head_dim, head_dim] for this layer; both are read at kernel start
+// and written back at kernel end with exactly the values the per-token
+// kernels would have left.
+cudaError_t kda_fused_chunk(
+    float *state,
+    const float *q_raw, const float *k_raw, const float *v_raw,
+    const float *gate_f, const float *gate_g, const float *beta,
+    const void *conv_q, const void *conv_k, const void *conv_v,
+    const float *dt_bias, const float *a_log, const uint16_t *norm_weight,
+    float *conv_history, float *output,
+    int tokens, int position_base,
+    int heads = kKdaHeads, int head_dim = kKdaHeadDim, bool weights_fp32 = false,
+    cudaStream_t stream = nullptr);
+
 // Exact dense attention for the first kMlaMaxContext positions. GLM's sparse
